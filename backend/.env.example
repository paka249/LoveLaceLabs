# Which AI provider to use: "mock" (canned streaming replies, no external
# calls or key required) or "gemini" (calls the real Gemini API).
AI_PROVIDER=mock

# Port the backend listens on.
PORT=3001

# Origin allowed to call this API (your frontend's dev server URL).
CORS_ORIGIN=http://localhost:5173

# Required when AI_PROVIDER=gemini. Get a free key at https://aistudio.google.com.
# Never commit a real value here - this file is the template, not the real .env.
GEMINI_API_KEY=

# Optional. Defaults to gemini-2.5-flash if unset.
# GEMINI_MODEL=gemini-2.5-flash
